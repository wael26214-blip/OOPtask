def find_car(racer, support, IDs):
    if not racer and not support:
        print("There are no cars in the garage to search.")
        return program_base(racer, support, IDs)
        

    print("Enter the ID of the car you want to find:")
    car_id = checkerOfExict(IDs)

    target_car = None
    
    for car in racer:
        if car.id == car_id:
            target_car = car
            break
            
    if not target_car:
        for car in support:
            if car.id == car_id:
                target_car = car
                break

    print(f"Car found! Here are the details for ID {car_id}:")
    target_car.display_info()
    
    program_base(racer, support, IDs)



def garage_report(racer, support, IDs):
    all_cars = racer + support
    total_cars = len(all_cars)
    
    if total_cars == 0:
        print("There are no cars in the garage to generate a report.")
        program_base(racer, support, IDs)
        return program_base(racer, support , IDs)

    total_performance = 0
    for car in all_cars:
        total_performance += car.performance()
    
    avg_performance = total_performance / total_cars

    teams_count = {}
    for car in all_cars:
        if car.team in teams_count:
            teams_count[car.team] += 1
        else:
            teams_count[car.team] = 1

    print("GARAGE REPORT")
    print(f"Total Cars Checked In: {total_cars}")
    print(f"Average Performance Score: {avg_performance:.2f}")
    print("Breakdown of Cars Per Team:")
    for team, count in teams_count.items():
        print(f"Team {team}: {count} car(s)")
    print("\n")

    program_base(racer, support, IDs)

program_base(racer,support,IDs)    
