class Car:
    def __init__(self, age, speed, capacity, id, name, type, team):
        self.age = age
        self.speed = speed
        self.capacity = capacity
        self.id = id
        self.name = name
        self.type = type
        self.team = team
    def performance (self):
        Performance = self.speed + self.capacity
        return Performance

    def display_info(self):
        print("ID:", self.id)
        print("Name:", self.name)
        print("Type:", self.type)
        print("Team:", self.team)
        print("Age:", self.age)
        print("Speed:", self.speed)
        print("Capacity:", self.capacity)
        print("Performance:", self.performance())
    


class Racer(Car):
    def __init__(self, age, speed, capacity, id, name, type, team, races, laps):
        super().__init__(age, speed, capacity, id, name, type, team)
        self.races = races
        self.laps = laps
    def performance (self):
            Performance = self.speed * 10 + self.capacity
            return Performance    
    def display_info(self):
         print("ID:", self.id)
         print("Name:", self.name)
         print("Type:", self.type)
         print("Team:", self.team)
         print("Age:", self.age)
         print("Speed:", self.speed)
         print("Capacity:", self.capacity)
         print("Performance:", self.performance())
         print( "Races:",self.races)
         print("Laps:",self.laps)

class SupportVehicle(Car):
    def __init__(self, age, speed, capacity, id, name, type, team, crew, reliability):
        super().__init__(age, speed, capacity, id, name, type, team)
        self.crew = crew
        self.reliability = reliability
    def performance (self):
            Performance = self.speed * 5 + self.capacity * 5
            return Performance    
    def display_info(self):
        print("ID:", self.id)
        print("Name:", self.name)
        print("Type:", self.type)
        print("Team:", self.team)
        print("Age:", self.age)
        print("Speed:", self.speed)
        print("Capacity:", self.capacity)
        print("Performance:", self.performance())
        print( "Crew:",self.crew)
        print("Reliability:",self.reliability)

def program_base( racer , support ,IDs):  
    
        print("=========================================")
        print("            GARAGE MANAGEMENT            ")
        print("=========================================")
        print("1. Check In a Car")
        print("2. View the Garage")
        print("3. Tune-Up")
        print("4. Retire")
        print("5. Find a Car")
        print("6. Garage Report")
        print("7. Exit")
        
        choice = int(input("Enter your choice (1-7): "))
       

        match choice:
            case 1:
                build(racer , support ,IDs)
            case 2:
                view(racer , support , IDs)
            case 3:
                tune_up(racer, support, IDs)
            case 4:
                retire(racer, support, IDs)
            case 5:
                find_car(racer, support, IDs)
            case 6:
                garage_report(racer, support, IDs)
            case 7:
                print("Exiting program. Goodbye!")
            case _:
                print("Invalid choice! Please choose a number between 1 and 7.")
                program_base(racer , support , IDs)

def build(racer , support ,IDs) :
    Tybe = int(input('Enter car type 1. Race , 2. support: '))
    match Tybe :
        case 1 :
         age, speed, capacity, id, name, team, races, laps = racerSet(IDs)
         new_racer = Racer(age, speed, capacity, id, name, "Racer", team, races, laps)
         racer.append(new_racer)
         print("Racer added successfully!")
         program_base(racer, support, IDs)
            
        case 2 :
         age, speed, capacity, id, name, team, crew, reliability = supportSet(IDs)
         new_support = SupportVehicle(age, speed, capacity, id, name, "Support", team, crew, reliability)
         support.append(new_support)
         print("Support vehicle added successfully!")
         program_base(racer, support, IDs)
        case _ :
            build(racer , support ,IDs)
    
