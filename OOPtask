        return capacitySet() 
def idSet(IDs) :
    print('Enter the ID of the car: ')  
    return checker(IDs)
def checker(IDs):
    while True:
        car_id = input()
        if car_id in IDs:
            print("Error: This ID already exists! Enter a new ID: ")
        else:
            IDs.append(car_id)
            return car_id 
def nameSet():
    name = input ('Enter car name: ')
    return name
def teamSet():
    team = input ('Enter team name: ') 
    return team  

     
def racerSet(IDs):
    age, speed, capacity, id, name, team = basicSet(IDs) 
    races = racesSet()
    laps = 4 * races
    return age, speed, capacity, id, name, team, races, laps
def racesSet() :
     races = int(input ('Enter number of races: '))  
     return races


     
def supportSet(IDs) :
    age, speed, capacity, id, name, team = basicSet(IDs)   
    crew = crewSet()
    reliability = reliabilitySet() 
    return age, speed, capacity, id, name, team, crew, reliability
