def view(racer , support , IDs) :
    if not racer and not support:
        print("There are no cars in the garage at all.")
    
    if racer:
        print("--- Racing Cars ---")
        for RACER in racer:
            RACER.display_info()
            
    if support:
        print("--- Support Vehicles ---")
        for SUP in support:
            SUP.display_info()      
    program_base(racer, support, IDs) 


def retire(racer, support, IDs):
    if not racer and not support:
        print("There are no cars in the garage to retire.")
        program_base(racer, support, IDs)
        return

    print("Enter the ID of the car you want to retire: ")
    car_id = checkerOfExict(IDs)
    
    
    for car in racer:
        if car.id == car_id:
            racer.remove(car)
            IDs.remove(car_id)
            print("Car retired successfully!")
            program_base(racer, support, IDs)
            return

    
    for car in support:
        if car.id == car_id:
            support.remove(car)
            IDs.remove(car_id)
            print("Car retired successfully!")
            program_base(racer, support, IDs)
            return
def checkerOfExict(IDs) :
    while True:
            car_id = input()
            if car_id not in IDs:
                print("Error: This ID doesn't exist! Enter a new ID: ")
            else:
                return car_id 



def tune_up(racer, support, IDs):
    if not racer and not support:
        print("There are no cars in the garage to tune-up.")
        return program_base(racer, support, IDs)
        

    print("Enter the ID of the car you want to tune-up:")
    car_id = checkerOfExict(IDs)

    target_car = None
    is_racer = True
    
    for car in racer:
        if car.id == car_id:
            target_car = car
            break
            
    if not target_car:
        for car in support:
            if car.id == car_id:
                target_car = car
                is_racer = False
                break

    print(f"Current details for car {car_id}:")
    target_car.display_info()
    
    print("Enter new details:")
    age, speed, capacity, name, team = basicReset()

    target_car.age = age
    target_car.speed = speed
    target_car.capacity = capacity
    target_car.name = name
    target_car.team = team

    if is_racer:
        races = racesSet()
        target_car.races = races
        target_car.laps = 4 * races
    else:
        crew = crewSet()
        reliability = reliabilitySet()
        target_car.crew = crew
        target_car.reliability = reliability

    print("Car tuned-up successfully!")
    program_base(racer, support, IDs)   
